# ── Copy to .env and fill in. NEVER commit real secrets. ──

# Node environment: 'production' or leave unset for local dev
NODE_ENV=

# PostgreSQL connection string (REQUIRED in production).
# In production the server refuses to start without this.
DATABASE_URL=

# Local dev PostgreSQL (used only when DATABASE_URL is unset)
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portofolio_db

# Admin panel password (REQUIRED to enable /v1/kernel-access login).
# If unset, admin login is disabled.
KERNEL_PASSWORD=

# Comma-separated list of allowed CORS origins, e.g.
# https://your-domain.com,http://localhost:5173
# If unset, only same-origin (no Origin header) requests are allowed.
ALLOWED_ORIGINS=

# OSINT daily scan limit per IP
OSINT_DAILY_LIMIT=3

# Optional integrations
APIFY_TOKEN=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=

# Cloudinary (either CLOUDINARY_URL or the three separate vars)
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
